        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="F3 — Ex3: một lượt chat hỏi tồn kho, ai làm gì" vertex="1"><mxGeometry height="30" width="1300" x="20" y="16" as="geometry" /></mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="Code @ 23cd011 (working tree)" vertex="1"><mxGeometry height="40" width="1300" x="20" y="50" as="geometry" /></mxCell>
        <mxCell id="sw_sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="Đọc từ trên xuống. Mỗi cột là một thành phần; ô ghi &quot;Làm gì&quot; và file:dòng." vertex="1"><mxGeometry height="34" width="1380" x="20" y="70" as="geometry" /></mxCell>
        <mxCell id="lane_u" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;" value="" vertex="1"><mxGeometry height="1414" width="290" x="20" y="114" as="geometry" /></mxCell>
        <mxCell id="lh_u" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Người dùng + console&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Console.ReadLine / Write&lt;/span&gt;" vertex="1"><mxGeometry height="54" width="290" x="20" y="114" as="geometry" /></mxCell>
        <mxCell id="lane_p" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;" value="" vertex="1"><mxGeometry height="1414" width="290" x="328" y="114" as="geometry" /></mxCell>
        <mxCell id="lh_p" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Vòng chat&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Ex3/Program.cs&lt;/span&gt;" vertex="1"><mxGeometry height="54" width="290" x="328" y="114" as="geometry" /></mxCell>
        <mxCell id="lane_f" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=35;" value="" vertex="1"><mxGeometry height="1414" width="290" x="636" y="114" as="geometry" /></mxCell>
        <mxCell id="lh_f" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b style=&quot;font-size:13px&quot;&gt;FunctionInvokingChatClient&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;middleware + FunctionInvoker&lt;/span&gt;" vertex="1"><mxGeometry height="54" width="290" x="636" y="114" as="geometry" /></mxCell>
        <mxCell id="lane_e" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=35;" value="" vertex="1"><mxGeometry height="1414" width="290" x="944" y="114" as="geometry" /></mxCell>
        <mxCell id="lh_e" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Erp (tool)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;GetStock, GetOrderStatus, ListLowStock&lt;/span&gt;" vertex="1"><mxGeometry height="54" width="290" x="944" y="114" as="geometry" /></mxCell>
        <mxCell id="s_a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. Gõ câu hỏi&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&amp;quot;SP-002 còn bao nhiêu?&amp;quot;; /exit hoặc null thì thoát, rỗng thì hỏi lại.&#xa;Code: tutorial/ngay-02/Ex3/Program.cs:65-68&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="260" x="35" y="174" as="geometry" /></mxCell>
        <mxCell id="s_b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. Thêm User vào history, stream&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;history.Add(User); await foreach GetStreamingResponseAsync(history, options).&#xa;Code: tutorial/ngay-02/Ex3/Program.cs:70-73&lt;/span&gt;" vertex="1"><mxGeometry height="153" width="260" x="343" y="339" as="geometry" /></mxCell>
        <mxCell id="s_c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. Mô hình xin tool, FunctionInvoker chạy&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Log tên tool + tham số, bấm giờ, InvokeAsync, in &amp;quot; -&amp;gt; ok, N ms (vòng K)&amp;quot;.&#xa;Code: tutorial/ngay-02/Ex3/Program.cs:22-30&lt;/span&gt;" vertex="1"><mxGeometry height="153" width="260" x="651" y="538" as="geometry" /></mxCell>
        <mxCell id="s_d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. Erp.GetStock chạy&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Tra Dictionary Stock, trả object chỉ gồm 4 trường mô hình cần.&#xa;Code: tutorial/ngay-02/Ex3/Program.cs:120-127&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="260" x="959" y="737" as="geometry" /></mxCell>
        <mxCell id="s_g" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b style=&quot;font-size:13px&quot;&gt;5. Hỏi lại mô hình với kết quả&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Mô hình viết câu trả lời; các update chữ chảy ra ngoài.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="260" x="651" y="902" as="geometry" /></mxCell>
        <mxCell id="s_h" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;6. In từng update, gom lại&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Console.Write(update.Text); updates.Add(update).&#xa;Code: tutorial/ngay-02/Ex3/Program.cs:73-77&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="260" x="343" y="1033" as="geometry" /></mxCell>
        <mxCell id="s_i" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;7. Lưu lịch sử đủ ngữ cảnh&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;history.AddMessages(updates.ToChatResponse()); in &amp;quot;[lịch sử: N tin]&amp;quot;.&#xa;Code: tutorial/ngay-02/Ex3/Program.cs:80-82&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="260" x="343" y="1198" as="geometry" /></mxCell>
        <mxCell id="s_j" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;8. Thấy câu trả lời&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Vòng lặp quay lại bước 1 với cùng history.&#xa;Code: tutorial/ngay-02/Ex3/Program.cs:63-65&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="260" x="35" y="1363" as="geometry" /></mxCell>
