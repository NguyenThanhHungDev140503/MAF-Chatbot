      <root><mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="F4 — Lệnh /reset, /stats và vòng đời session" vertex="1"><mxGeometry height="30" width="1300" x="20" y="16" as="geometry" /></mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="Code @ 23cd011" vertex="1"><mxGeometry height="40" width="1300" x="20" y="50" as="geometry" /></mxCell>
        <mxCell id="sw_sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="/reset xoá ngữ cảnh nhưng giữ thống kê. Session chỉ đổi ở hai chỗ: lượt đầu (tạo) và /reset (tạo lại)." vertex="1"><mxGeometry height="34" width="1380" x="20" y="70" as="geometry" /></mxCell>
