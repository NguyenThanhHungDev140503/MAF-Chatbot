        <mxCell id="e11" edge="1" parent="1" source="n_c2" target="n_ok" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;" value="Không lỗi"><mxGeometry relative="1" as="geometry" /></mxCell>
