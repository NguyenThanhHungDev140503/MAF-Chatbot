        <mxCell id="lh_cli" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;CliCommandHandler&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Cli&lt;/span&gt;" vertex="1"><mxGeometry height="54" width="290" x="20" y="114" as="geometry" /></mxCell>
