  <diagram id="p06" name="F3a Một lượt chat - Kiến trúc">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="sum_t" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="Flow 3 trong 1 phút: từ Enter đến dòng thống kê token" vertex="1"><mxGeometry height="30" width="1380" x="20" y="20" as="geometry" /></mxCell>
        <mxCell id="sum_ctx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Bối cảnh&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Mỗi lượt đi qua 3 tầng. Chỉ ErpAgentService biết MAF; CliChatLoop chỉ nhận IAsyncEnumerable&amp;lt;string&amp;gt;.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="1380" x="20" y="62" as="geometry" /></mxCell>
        <mxCell id="sum_leg" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="xanh lá = đường bình thường; đỏ = lượt bị hủy hoặc lỗi giữa chừng" vertex="1"><mxGeometry height="22" width="1380" x="20" y="144" as="geometry" /></mxCell>
        <mxCell id="sum_s0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. Phân loại input&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;CliCommandHandler trả SendToLlm cho dòng không bắt đầu bằng &amp;#x27;/&amp;#x27;.&lt;/span&gt;" vertex="1"><mxGeometry height="100" width="307" x="20" y="174" as="geometry" /></mxCell>
        <mxCell id="sum_s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. Mở stream&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Lượt đầu tạo AgentSession; sau đó dùng lại session đó.&lt;/span&gt;" vertex="1"><mxGeometry height="100" width="307" x="377" y="174" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="sum_s0" target="sum_s1" style="html=1;endArrow=block;strokeWidth=1.5;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sum_s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. Đọc từng update&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Có text thì yield; có UsageContent thì cộng token lượt này.&lt;/span&gt;" vertex="1"><mxGeometry height="100" width="307" x="735" y="174" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="sum_s1" target="sum_s2" style="html=1;endArrow=block;strokeWidth=1.5;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sum_s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. Ghi thống kê&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;RecordTurn sau khi stream xong; CliChatLoop in thời gian và token.&lt;/span&gt;" vertex="1"><mxGeometry height="100" width="307" x="1092" y="174" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="sum_s2" target="sum_s3" style="html=1;endArrow=block;strokeWidth=1.5;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sum_bad" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Hủy hoặc lỗi giữa stream?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;RecordTurn không chạy nên lượt đó không vào /stats; token lượt này in ra là 0. Session vẫn giữ.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="665" x="1092" y="304" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="sum_s3" target="sum_bad" style="html=1;endArrow=block;dashed=1;strokeWidth=1.5;" value="lỗi"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sum_why" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="Vì sao phải làm vậy?" vertex="1"><mxGeometry height="30" width="1380" x="20" y="402" as="geometry" /></mxCell>
        <mxCell id="sum_w0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Vì sao trừ tổng token&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;CliChatLoop không đọc token từ stream; nó lấy tổng trước lượt rồi trừ (CliRunner.cs:132, 143).&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="675" x="20" y="436" as="geometry" /></mxCell>
        <mxCell id="sum_w1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Vì sao stream&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Người dùng thấy câu trả lời ngay khi có chữ đầu tiên.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="675" x="725" y="436" as="geometry" /></mxCell>
        <mxCell id="sum_names" parent="1" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" value="Tên trong code: CliInputResult.SendToLlm, AgentSession, AgentResponseUpdate, UsageContent, SessionStats.RecordTurn" vertex="1"><mxGeometry height="24" width="1380" x="20" y="524" as="geometry" /></mxCell>
        <mxCell id="problem" parent="1" style="text;html=1;fontSize=18;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;Vấn đề.&lt;/b&gt; Người dùng muốn thấy chữ hiện dần, bot phải nhớ các lượt trước, và mỗi lượt phải đếm token. Ba việc này tách thành ba tầng: CliChatLoop (hiển thị), ErpAgentService (stream và đếm), AgentSession của MAF (nhớ lịch sử)." vertex="1"><mxGeometry height="70" width="1380" x="20" y="594" as="geometry" /></mxCell>
        <mxCell id="heading" parent="1" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="F3a — Một lượt chat: thành phần, xử lý và code" vertex="1"><mxGeometry height="30" width="1380" x="20" y="684" as="geometry" /></mxCell>
        <mxCell id="n_loop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:14px&quot;&gt;CliChatLoop.ProcessLineAsync — Điều phối một dòng&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Làm gì: Hỏi handler; nếu SendToLlm thì in &amp;#x27;Trợ lý: &amp;#x27;, bấm giờ, await foreach in từng chunk, rồi in dòng thống kê. Vì sao: Hiển thị nằm ngoài service nên service dễ test bằng fake.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="430" x="140" y="726" as="geometry" /></mxCell>
        <mxCell id="c_loop" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:112-145&#xa;public async Task&amp;lt;bool&amp;gt; ProcessLineAsync(string rawInput, CancellationToken userCancellation)&#xa;{&#xa;    try&#xa;    {&#xa;        var inputResult = await _commandHandler.HandleInputAsync(rawInput, userCancellation);&#xa;        if (inputResult == CliInputResult.Exit)&#xa;        {&#xa;            Console.WriteLine(&amp;quot;Tạm biệt!&amp;quot;);&#xa;            return false;&#xa;        }&#xa;        if (inputResult != CliInputResult.SendToLlm)&#xa;        {&#xa;            return true;&#xa;        }&#xa;&#xa;        Console.ForegroundColor = ConsoleColor.Green;&#xa;        Console.Write(&amp;quot;Trợ lý: &amp;quot;);&#xa;        Console.ResetColor();&#xa;&#xa;        var stopwatch = Stopwatch.StartNew();&#xa;        long prevTotalTokens = _agentService.GetStats().TotalTokens;&#xa;&#xa;        await foreach (var chunk in _agentService.RunStreamingAsync(rawInput, userCancellation))&#xa;        {&#xa;            Console.Write(chunk);&#xa;        }&#xa;        stopwatch.Stop();&#xa;        Console.WriteLine();&#xa;&#xa;        var currentStats = _agentService.GetStats();&#xa;        Console.ForegroundColor = ConsoleColor.DarkGray;&#xa;        Console.WriteLine($&amp;quot;  [Thời gian: {stopwatch.ElapsedMilliseconds}ms | Token lượt này: {currentStats.TotalTokens - prevTotalTokens} | Token tích luỹ: {currentStats.TotalTokens}]&amp;quot;);&#xa;        Console.ResetColor();&#xa;        Console.WriteLine();&lt;/div&gt;" vertex="1"><mxGeometry height="531" width="860" x="620" y="726" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="n_loop" target="c_loop" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_hd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:14px&quot;&gt;CliCommandHandler.HandleInputAsync — Phân loại input&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Làm gì: Rỗng thì Ignored; /exit thì Exit; lệnh &amp;#x27;/&amp;#x27; thì Handled; còn lại SendToLlm. Vì sao: Lệnh điều khiển không tốn lượt gọi model.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="430" x="140" y="1307" as="geometry" /></mxCell>
        <mxCell id="c_hd" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:37-49&#xa;public async Task&amp;lt;CliInputResult&amp;gt; HandleInputAsync(string input, CancellationToken cancellationToken)&#xa;{&#xa;    var trimmed = input.Trim();&#xa;    if (string.IsNullOrEmpty(trimmed))&#xa;    {&#xa;        return CliInputResult.Ignored;&#xa;    }&#xa;&#xa;    if (trimmed.Equals(&amp;quot;/exit&amp;quot;, StringComparison.OrdinalIgnoreCase) ||&#xa;        trimmed.Equals(&amp;quot;/quit&amp;quot;, StringComparison.OrdinalIgnoreCase))&#xa;    {&#xa;        return CliInputResult.Exit;&#xa;    }&#xa;&#xa;// code/src/ErpChatbot.Cli/CliRunner.cs:82-88&#xa;if (trimmed.StartsWith(&amp;quot;/&amp;quot;))&#xa;{&#xa;    Console.WriteLine($&amp;quot;\n[CẢNH BÁO] Lệnh &amp;#x27;{trimmed}&amp;#x27; không hợp lệ. Gõ /info hoặc /help để xem danh sách lệnh.\n&amp;quot;);&#xa;    return CliInputResult.Handled;&#xa;}&#xa;&#xa;return CliInputResult.SendToLlm;&lt;/div&gt;" vertex="1"><mxGeometry height="357" width="860" x="620" y="1307" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="n_hd" target="c_hd" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_svc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:14px&quot;&gt;ErpAgentService.RunStreamingAsync — Stream và đếm token&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Làm gì: Tạo session lượt đầu, mở stream của AIAgent, yield text, cộng token từ UsageContent, cuối cùng gọi SessionStats.RecordTurn (Core/Models/SessionStats.cs:10-15). Vì sao: Một chỗ giữ cả session lẫn thống kê.&lt;/span&gt;" vertex="1"><mxGeometry height="136" width="430" x="140" y="1715" as="geometry" /></mxCell>
        <mxCell id="c_svc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Agent/Services/ErpAgentService.cs:36-46&#xa;// Tự khởi tạo session nếu là lượt đầu tiên&#xa;_session ??= await _agent.CreateSessionAsync(cancellationToken);&#xa;&#xa;long turnInputTokens = 0;&#xa;long turnOutputTokens = 0;&#xa;&#xa;// Gọi RunStreamingAsync của AIAgent. Trả về IAsyncEnumerable&amp;lt;AgentResponseUpdate&amp;gt;&#xa;var responseStream = _agent.RunStreamingAsync(userPrompt, _session, options: null, cancellationToken: cancellationToken);&#xa;&#xa;await using var enumerator = responseStream.GetAsyncEnumerator(cancellationToken);&#xa;&#xa;&#xa;// code/src/ErpChatbot.Agent/Services/ErpAgentService.cs:66-87&#xa;    // Trích xuất text để stream ra UI&#xa;    if (!string.IsNullOrEmpty(update.Text))&#xa;    {&#xa;        yield return update.Text;&#xa;    }&#xa;&#xa;    // Trích xuất số token qua UsageContent trong Contents&#xa;    if (update.Contents != null)&#xa;    {&#xa;        foreach (var content in update.Contents)&#xa;        {&#xa;            if (content is UsageContent usageContent &amp;amp;&amp;amp; usageContent.Details != null)&#xa;            {&#xa;                turnInputTokens += usageContent.Details.InputTokenCount ?? 0;&#xa;                turnOutputTokens += usageContent.Details.OutputTokenCount ?? 0;&#xa;            }&#xa;        }&#xa;    }&#xa;}&#xa;&#xa;// Cập nhật thống kê token sau khi stream hoàn tất trọn vẹn&#xa;_stats.RecordTurn(turnInputTokens, turnOutputTokens);&lt;/div&gt;" vertex="1"><mxGeometry height="546" width="860" x="620" y="1715" as="geometry" /></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="n_svc" target="c_svc" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_llm" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" value="&lt;b&gt;AIAgent + Ollama IChatClient&lt;/b&gt;" vertex="1"><mxGeometry height="70" width="430" x="140" y="2311" as="geometry" /></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="n_loop" target="n_hd" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;" value="HandleInputAsync(rawInput)"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="n_hd" target="n_svc" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;" value="SendToLlm: loop gọi RunStreamingAsync"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="n_svc" target="n_llm" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;" value="RunStreamingAsync(prompt, _session)"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sec0_t" parent="1" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="Rủi ro trong flow này" vertex="1"><mxGeometry height="30" width="1380" x="20" y="2431" as="geometry" /></mxCell>
        <mxCell id="sec0_n" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="Đọc từ code, chưa chạy thật với Ollama." vertex="1"><mxGeometry height="34" width="1380" x="20" y="2465" as="geometry" /></mxCell>
        <mxCell id="sec0_b0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Thống kê mất khi hủy&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;RecordTurn nằm sau vòng lặp (ErpAgentService.cs:87). Ctrl+C hoặc lỗi giữa stream không tính lượt và token vào /stats.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="440" x="20" y="2505" as="geometry" /></mxCell>
        <mxCell id="sec0_b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b style=&quot;font-size:13px&quot;&gt;catch { throw; } dư&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;ErpAgentService.cs:59-64 chỉ throw lại, có hay không cũng giống nhau. Session được giữ vì không có dòng nào gán lại _session.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="440" x="490" y="2505" as="geometry" /></mxCell>
        <mxCell id="sec0_b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Chưa xác minh&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Việc AgentSession của MAF có giữ câu trả lời dở sau khi hủy hay không; logic nằm trong thư viện, repo không có code.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="440" x="960" y="2505" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p07" name="F3b Một lượt chat - Các bước kiểm tra">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="F3b — Các cổng kiểm tra trước khi gọi model" vertex="1"><mxGeometry height="30" width="1300" x="20" y="16" as="geometry" /></mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="Code @ 23cd011" vertex="1"><mxGeometry height="40" width="1300" x="20" y="50" as="geometry" /></mxCell>
        <mxCell id="c_in" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:112-116&#xa;public async Task&amp;lt;bool&amp;gt; ProcessLineAsync(string rawInput, CancellationToken userCancellation)&#xa;{&#xa;    try&#xa;    {&#xa;        var inputResult = await _commandHandler.HandleInputAsync(rawInput, userCancellation);&lt;/div&gt;" vertex="1"><mxGeometry height="111" width="760" x="20" y="110" as="geometry" /></mxCell>
        <mxCell id="n_in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. ProcessLineAsync nhận một dòng&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Gọi HandleInputAsync(rawInput) rồi xét kết quả.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="870" y="110" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="c_in" target="n_in" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_d1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:39-43&#xa;var trimmed = input.Trim();&#xa;if (string.IsNullOrEmpty(trimmed))&#xa;{&#xa;    return CliInputResult.Ignored;&#xa;}&lt;/div&gt;" vertex="1"><mxGeometry height="111" width="760" x="20" y="277" as="geometry" /></mxCell>
        <mxCell id="n_d1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. Dòng rỗng hoặc toàn khoảng trắng?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Trim() rồi IsNullOrEmpty.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="870" y="277" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="c_d1" target="n_d1" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_r1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:42-42&#xa;return CliInputResult.Ignored;&lt;/div&gt;" vertex="1"><mxGeometry height="53" width="760" x="20" y="402" as="geometry" /></mxCell>
        <mxCell id="n_r1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Bỏ qua: CliInputResult.Ignored&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Không gọi model; vòng lặp hiện lại &amp;#x27;Bạn:&amp;#x27;.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="1390" y="277" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="c_r1" target="n_r1" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_d2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:45-49&#xa;if (trimmed.Equals(&amp;quot;/exit&amp;quot;, StringComparison.OrdinalIgnoreCase) ||&#xa;    trimmed.Equals(&amp;quot;/quit&amp;quot;, StringComparison.OrdinalIgnoreCase))&#xa;{&#xa;    return CliInputResult.Exit;&#xa;}&lt;/div&gt;" vertex="1"><mxGeometry height="111" width="760" x="20" y="511" as="geometry" /></mxCell>
        <mxCell id="n_d2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. Là /exit hoặc /quit?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;So sánh OrdinalIgnoreCase.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="870" y="511" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="c_d2" target="n_d2" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_r2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:117-121&#xa;if (inputResult == CliInputResult.Exit)&#xa;{&#xa;    Console.WriteLine(&amp;quot;Tạm biệt!&amp;quot;);&#xa;    return false;&#xa;}&lt;/div&gt;" vertex="1"><mxGeometry height="111" width="760" x="20" y="636" as="geometry" /></mxCell>
        <mxCell id="n_r2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Thoát: in &amp;#x27;Tạm biệt!&amp;#x27;, return false&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Program.cs break khỏi vòng lặp.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="1390" y="511" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="c_r2" target="n_r2" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_d3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:51-86&#xa;if (trimmed.Equals(&amp;quot;/reset&amp;quot;, StringComparison.OrdinalIgnoreCase))&#xa;{&#xa;    await _agentService.ResetSessionAsync();&#xa;    Console.WriteLine(&amp;quot;\n[HỆ THỐNG] Đã xoá lịch sử phiên chat. Agent đã bắt đầu một phiên mới.\n&amp;quot;);&#xa;    return CliInputResult.Handled;&#xa;}&#xa;&#xa;if (trimmed.Equals(&amp;quot;/stats&amp;quot;, StringComparison.OrdinalIgnoreCase))&#xa;{&#xa;    var stats = _agentService.GetStats();&#xa;    Console.WriteLine($&amp;quot;\n--- THỐNG KÊ PHIÊN CHAT ---&amp;quot;);&#xa;    Console.WriteLine($&amp;quot;Số lượt trò chuyện: {stats.TurnCount}&amp;quot;);&#xa;    Console.WriteLine($&amp;quot;Tổng Token vào (Input):  {stats.TotalInputTokens}&amp;quot;);&#xa;    Console.WriteLine($&amp;quot;Tổng Token ra (Output): {stats.TotalOutputTokens}&amp;quot;);&#xa;    Console.WriteLine($&amp;quot;Tổng Token đã dùng:     {stats.TotalTokens}\n&amp;quot;);&#xa;    return CliInputResult.Handled;&#xa;}&#xa;&#xa;if (trimmed.Equals(&amp;quot;/info&amp;quot;, StringComparison.OrdinalIgnoreCase) ||&#xa;    trimmed.Equals(&amp;quot;/help&amp;quot;, StringComparison.OrdinalIgnoreCase))&#xa;{&#xa;    Console.WriteLine($&amp;quot;\n--- THÔNG TIN HỆ THỐNG ---&amp;quot;);&#xa;    Console.WriteLine($&amp;quot;Trợ lý:    {_erpOptions.AssistantName} ({_erpOptions.CompanyName})&amp;quot;);&#xa;    Console.WriteLine($&amp;quot;Chỉ dẫn:   {_erpOptions.Instructions}&amp;quot;);&#xa;    Console.WriteLine($&amp;quot;Provider:  {_llmOptions.Provider}&amp;quot;);&#xa;    Console.WriteLine($&amp;quot;Model:     {_llmOptions.Model}&amp;quot;);&#xa;    Console.WriteLine($&amp;quot;Endpoint:  {_llmOptions.Ollama.Endpoint}&amp;quot;);&#xa;    Console.WriteLine($&amp;quot;Lệnh sẵn sàng: /reset, /stats, /info, /exit\n&amp;quot;);&#xa;    return CliInputResult.Handled;&#xa;}&#xa;&#xa;if (trimmed.StartsWith(&amp;quot;/&amp;quot;))&#xa;{&#xa;    Console.WriteLine($&amp;quot;\n[CẢNH BÁO] Lệnh &amp;#x27;{trimmed}&amp;#x27; không hợp lệ. Gõ /info hoặc /help để xem danh sách lệnh.\n&amp;quot;);&#xa;    return CliInputResult.Handled;&#xa;}&lt;/div&gt;" vertex="1"><mxGeometry height="560" width="760" x="20" y="803" as="geometry" /></mxCell>
        <mxCell id="n_d3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. Là lệnh &amp;#x27;/&amp;#x27;?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;/reset, /stats, /info, /help xử lý tại chỗ; mọi dòng &amp;#x27;/&amp;#x27; khác in cảnh báo.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="420" x="870" y="803" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="c_d3" target="n_d3" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_r3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:122-125&#xa;if (inputResult != CliInputResult.SendToLlm)&#xa;{&#xa;    return true;&#xa;}&lt;/div&gt;" vertex="1"><mxGeometry height="96" width="760" x="20" y="1377" as="geometry" /></mxCell>
        <mxCell id="n_r3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Xử lý tại chỗ: CliInputResult.Handled&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Không gọi model; ProcessLineAsync return true.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="1390" y="803" as="geometry" /></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="c_r3" target="n_r3" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_s1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Agent/Services/ErpAgentService.cs:36-43&#xa;// Tự khởi tạo session nếu là lượt đầu tiên&#xa;_session ??= await _agent.CreateSessionAsync(cancellationToken);&#xa;&#xa;long turnInputTokens = 0;&#xa;long turnOutputTokens = 0;&#xa;&#xa;// Gọi RunStreamingAsync của AIAgent. Trả về IAsyncEnumerable&amp;lt;AgentResponseUpdate&amp;gt;&#xa;var responseStream = _agent.RunStreamingAsync(userPrompt, _session, options: null, cancellationToken: cancellationToken);&lt;/div&gt;" vertex="1"><mxGeometry height="154" width="760" x="20" y="1530" as="geometry" /></mxCell>
        <mxCell id="n_s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;5. Gửi prompt cho agent&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Lượt đầu tạo AgentSession; sau đó dùng lại.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="870" y="1530" as="geometry" /></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="c_s1" target="n_s1" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_s2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Agent/Services/ErpAgentService.cs:66-83&#xa;// Trích xuất text để stream ra UI&#xa;if (!string.IsNullOrEmpty(update.Text))&#xa;{&#xa;    yield return update.Text;&#xa;}&#xa;&#xa;// Trích xuất số token qua UsageContent trong Contents&#xa;if (update.Contents != null)&#xa;{&#xa;    foreach (var content in update.Contents)&#xa;    {&#xa;        if (content is UsageContent usageContent &amp;amp;&amp;amp; usageContent.Details != null)&#xa;        {&#xa;            turnInputTokens += usageContent.Details.InputTokenCount ?? 0;&#xa;            turnOutputTokens += usageContent.Details.OutputTokenCount ?? 0;&#xa;        }&#xa;    }&#xa;}&lt;/div&gt;" vertex="1"><mxGeometry height="299" width="760" x="20" y="1740" as="geometry" /></mxCell>
        <mxCell id="n_s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;6. Đọc stream: yield text, cộng token&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Text không rỗng thì yield; UsageContent cộng input và output token.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="420" x="870" y="1740" as="geometry" /></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="c_s2" target="n_s2" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_ok" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Agent/Services/ErpAgentService.cs:87-87&#xa;_stats.RecordTurn(turnInputTokens, turnOutputTokens);&#xa;&#xa;// code/src/ErpChatbot.Cli/CliRunner.cs:141-145&#xa;var currentStats = _agentService.GetStats();&#xa;Console.ForegroundColor = ConsoleColor.DarkGray;&#xa;Console.WriteLine($&amp;quot;  [Thời gian: {stopwatch.ElapsedMilliseconds}ms | Token lượt này: {currentStats.TotalTokens - prevTotalTokens} | Token tích luỹ: {currentStats.TotalTokens}]&amp;quot;);&#xa;Console.ResetColor();&#xa;Console.WriteLine();&lt;/div&gt;" vertex="1"><mxGeometry height="154" width="760" x="20" y="2096" as="geometry" /></mxCell>
        <mxCell id="n_ok" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#b9e0a5;strokeColor=#4d8f2c;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;7. RecordTurn và in dòng thống kê&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Token lượt này = tổng mới trừ tổng trước lượt.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="870" y="2096" as="geometry" /></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="c_ok" target="n_ok" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
