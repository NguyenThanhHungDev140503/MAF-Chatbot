  <diagram id="p07" name="F4 Ex4 duyệt trước khi ghi - Swimlane">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="F4 — Ex4: tool ghi dữ liệu phải được người dùng duyệt, ai làm gì" vertex="1"><mxGeometry height="30" width="1300" x="20" y="16" as="geometry" /></mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="Code @ 23cd011 (working tree)" vertex="1"><mxGeometry height="40" width="1300" x="20" y="50" as="geometry" /></mxCell>
        <mxCell id="sw_sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="Đọc từ trên xuống. Đã đối chiếu code: system prompt Ex4 không có câu &quot;không bịa số&quot;, và agent không đặt MaximumIterationsPerRequest (dùng mặc định)." vertex="1"><mxGeometry height="34" width="1380" x="20" y="70" as="geometry" /></mxCell>
        <mxCell id="lane_u" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;" value="" vertex="1"><mxGeometry height="1613" width="290" x="20" y="114" as="geometry" /></mxCell>
        <mxCell id="lh_u" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Người dùng&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;console y/n&lt;/span&gt;" vertex="1"><mxGeometry height="54" width="290" x="20" y="114" as="geometry" /></mxCell>
        <mxCell id="lane_p" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;" value="" vertex="1"><mxGeometry height="1613" width="290" x="328" y="114" as="geometry" /></mxCell>
        <mxCell id="lh_p" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Vòng chat Ex4&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Program.cs&lt;/span&gt;" vertex="1"><mxGeometry height="54" width="290" x="328" y="114" as="geometry" /></mxCell>
        <mxCell id="lane_a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=35;" value="" vertex="1"><mxGeometry height="1613" width="290" x="636" y="114" as="geometry" /></mxCell>
        <mxCell id="lh_a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b style=&quot;font-size:13px&quot;&gt;ChatClientAgent&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;AIAgent + AgentSession&lt;/span&gt;" vertex="1"><mxGeometry height="54" width="290" x="636" y="114" as="geometry" /></mxCell>
        <mxCell id="lane_w" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;opacity=35;" value="" vertex="1"><mxGeometry height="1613" width="290" x="944" y="114" as="geometry" /></mxCell>
        <mxCell id="lh_w" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b style=&quot;font-size:13px&quot;&gt;CreatePurchaseRequest&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;tool GHI vào ERP&lt;/span&gt;" vertex="1"><mxGeometry height="54" width="290" x="944" y="114" as="geometry" /></mxCell>
        <mxCell id="s_s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. Dựng agent + session&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;AsAIAgent(tools: [getStock, new ApprovalRequiredAIFunction(createPr)]); CreateSessionAsync().&#xa;Code: tutorial/ngay-02/Ex4/Program.cs:17-22&lt;/span&gt;" vertex="1"><mxGeometry height="136" width="260" x="343" y="174" as="geometry" /></mxCell>
        <mxCell id="s_s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. &amp;quot;Tạo đề xuất đặt mua 20 cái SP-003&amp;quot;&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Gõ câu hỏi vào console.&#xa;Code: tutorial/ngay-02/Ex4/Program.cs:27-30&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="260" x="35" y="356" as="geometry" /></mxCell>
        <mxCell id="s_s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. RunAsync, dừng lại xin duyệt&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Mô hình xin create_purchase_request; hàm bọc Approval nên agent KHÔNG chạy mà trả ToolApprovalRequestContent.&#xa;Code: tutorial/ngay-02/Ex4/Program.cs:32-36&lt;/span&gt;" vertex="1"><mxGeometry height="153" width="260" x="651" y="521" as="geometry" /></mxCell>
        <mxCell id="s_s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. Hỏi y/n từng yêu cầu&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Cast req.ToolCall sang FunctionCallContent, in tên hàm + tham số, đọc dòng nhập; chỉ &amp;quot;y&amp;quot; là duyệt.&#xa;Code: tutorial/ngay-02/Ex4/Program.cs:39-45&lt;/span&gt;" vertex="1"><mxGeometry height="136" width="260" x="343" y="720" as="geometry" /></mxCell>
        <mxCell id="s_s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;5. Gõ y hoặc n&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Quyết định của người thật.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="260" x="35" y="902" as="geometry" /></mxCell>
        <mxCell id="s_s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b style=&quot;font-size:13px&quot;&gt;6. RunAsync(answers, CÙNG session)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Gửi req.CreateResponse(ok) dưới vai User để agent chạy tiếp hoặc báo bị từ chối.&#xa;Code: tutorial/ngay-02/Ex4/Program.cs:47-48&lt;/span&gt;" vertex="1"><mxGeometry height="153" width="260" x="651" y="1016" as="geometry" /></mxCell>
        <mxCell id="s_s7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b style=&quot;font-size:13px&quot;&gt;7a. Đã duyệt: C# GHI vào ERP&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Tạo PR-xxxx, trả requestId + trạng thái chờ trưởng phòng phê duyệt.&#xa;Code: tutorial/ngay-02/Ex4/Program.cs:65-73&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="260" x="959" y="1215" as="geometry" /></mxCell>
        <mxCell id="s_s8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b style=&quot;font-size:13px&quot;&gt;7b. Từ chối: hàm KHÔNG chạy&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Mô hình nhận &amp;quot;Tool call invocation was rejected by the approver and must not be retried.&amp;quot; (PDF trang 7).&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="260" x="651" y="1380" as="geometry" /></mxCell>
        <mxCell id="s_s9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;8. Lặp đến hết yêu cầu duyệt, in câu trả lời&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;while còn ToolApprovalRequestContent; cuối cùng Console.WriteLine(response.Text).&#xa;Code: tutorial/ngay-02/Ex4/Program.cs:35-51&lt;/span&gt;" vertex="1"><mxGeometry height="153" width="260" x="343" y="1528" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="s_s1" target="s_s2" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
