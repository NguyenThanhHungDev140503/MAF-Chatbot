        <mxCell id="cs1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;1. AIFunctionFactory.Create(GetStock, name: &amp;quot;get_stock&amp;quot;)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:16-16&#xa;AIFunction getStock = AIFunctionFactory.Create(GetStock, name: &amp;quot;get_stock&amp;quot;);&lt;/div&gt;" vertex="1"><mxGeometry height="79" width="537" x="20" y="1094" as="geometry" /></mxCell>
        <mxCell id="cs2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;2. &amp;quot;Mã SP-001 còn bao nhiêu trong kho?&amp;quot;&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:20-24&#xa;List&amp;lt;ChatMessage&amp;gt; history =&#xa;[&#xa;    new(ChatRole.System, &amp;quot;Bạn là Trợ lý ERP. Trả lời tiếng Việt, ngắn gọn. Chỉ dùng số liệu lấy từ tool, không bịa.&amp;quot;),&#xa;    new(ChatRole.User, &amp;quot;Mã SP-001 còn bao nhiêu trong kho?&amp;quot;)&#xa;];&lt;/div&gt;" vertex="1"><mxGeometry height="137" width="760" x="20" y="1197" as="geometry" /></mxCell>
        <mxCell id="cs3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;3. Lượt 1: GetResponseAsync(history, options{Tools})&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:27-28&#xa;ChatResponse response = await client.GetResponseAsync(history, options);&#xa;history.AddMessages(response);&lt;/div&gt;" vertex="1"><mxGeometry height="93" width="520" x="20" y="1358" as="geometry" /></mxCell>
        <mxCell id="cs4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;4. FunctionCallContent get_stock(productCode=SP-001), CallId&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:31-32&#xa;var calls = response.Messages.SelectMany(m =&amp;gt; m.Contents).OfType&amp;lt;FunctionCallContent&amp;gt;().ToList();&#xa;Console.WriteLine($&amp;quot;Lượt 1: mô hình xin gọi {calls.Count} hàm, FinishReason = {response.FinishReason}&amp;quot;);&lt;/div&gt;" vertex="1"><mxGeometry height="93" width="724" x="20" y="1475" as="geometry" /></mxCell>
        <mxCell id="cs5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;5. InvokeAsync(call.Arguments): CODE CỦA BẠN chạy hàm&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:39-39&#xa;object? result = await getStock.InvokeAsync(new AIFunctionArguments(call.Arguments));&lt;/div&gt;" vertex="1"><mxGeometry height="79" width="597" x="20" y="1593" as="geometry" /></mxCell>
        <mxCell id="cs6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;6. GetStock(&amp;quot;SP-001&amp;quot;)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:55-58&#xa;static StockInfo GetStock([Description(&amp;quot;Mã sản phẩm, ví dụ SP-001&amp;quot;)] string productCode)&#xa;{&#xa;    Console.WriteLine($&amp;quot;     (C# đang chạy GetStock(\&amp;quot;{productCode}\&amp;quot;))&amp;quot;);&#xa;    return productCode.ToUpperInvariant() switch&lt;/div&gt;" vertex="1"><mxGeometry height="122" width="617" x="20" y="1696" as="geometry" /></mxCell>
        <mxCell id="cs7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;7. StockInfo(SP-001, Bàn phím cơ K87, 124, cái, Kho Hà Nội)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:60-60&#xa;&amp;quot;SP-001&amp;quot; =&amp;gt; new(&amp;quot;SP-001&amp;quot;, &amp;quot;Bàn phím cơ K87&amp;quot;, 124, &amp;quot;cái&amp;quot;, &amp;quot;Kho Hà Nội&amp;quot;),&lt;/div&gt;" vertex="1"><mxGeometry height="79" width="520" x="20" y="1842" as="geometry" /></mxCell>
        <mxCell id="cs9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;9. Lượt 2: history có thêm Tool/FunctionResultContent(CallId, result)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:40-40&#xa;history.Add(new ChatMessage(ChatRole.Tool, [new FunctionResultContent(call.CallId, result)]));&#xa;&#xa;// tutorial/ngay-02/Ex1/Program.cs:44-45&#xa;response = await client.GetResponseAsync(history, options);&#xa;history.AddMessages(response);&lt;/div&gt;" vertex="1"><mxGeometry height="137" width="657" x="20" y="1945" as="geometry" /></mxCell>
        <mxCell id="cs10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;10. Câu trả lời cuối bằng chữ (dựa trên số 124)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:46-46&#xa;Console.WriteLine($&amp;quot;\nTrợ lý: {response.Text}\n&amp;quot;);&lt;/div&gt;" vertex="1"><mxGeometry height="79" width="520" x="20" y="2106" as="geometry" /></mxCell>
        <mxCell id="cs11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;11. In lịch sử: system, user, assistant(Call), tool(Result), assistant(Text)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:49-51&#xa;Console.WriteLine(&amp;quot;Lịch sử hội thoại:&amp;quot;);&#xa;foreach (ChatMessage m in history)&#xa;    Console.WriteLine($&amp;quot;  [{m.Role}] {string.Join(&amp;quot;, &amp;quot;, m.Contents.Select(c =&amp;gt; c.GetType().Name))}&amp;quot;);&lt;/div&gt;" vertex="1"><mxGeometry height="108" width="704" x="20" y="2209" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p02" name="F1a AIFunctionFactory - Kiến trúc">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="sum_t" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="Flow 1 trong 1 phút: dán nhãn cho ngăn kéo để nhân viên mới biết mở ngăn nào" vertex="1"><mxGeometry height="30" width="1380" x="20" y="20" as="geometry" /></mxCell>
        <mxCell id="sum_ctx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Trước khi có tool&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Ngày 1 bot chỉ nói &amp;quot;tôi chưa có dữ liệu&amp;quot;. Muốn có số thật, phải cho mô hình biết có hàm nào và cách gọi, mà mô hình chỉ đọc được văn bản.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="1380" x="20" y="62" as="geometry" /></mxCell>
        <mxCell id="sum_leg" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="Màu ô:  xanh lá = code của bạn   |   xanh dương = thư viện Microsoft.Extensions.AI   |   tím = mô hình" vertex="1"><mxGeometry height="22" width="1380" x="20" y="144" as="geometry" /></mxCell>
        <mxCell id="sum_s0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. Viết hàm + [Description]&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Mô tả hàm và từng tham số bằng tiếng người: đây là prompt mô hình đọc để chọn hàm.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="307" x="20" y="174" as="geometry" /></mxCell>
        <mxCell id="sum_s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. AIFunctionFactory.Create&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Đọc chữ ký, sinh AIFunction gồm Name, Description, JsonSchema. Phải truyền name: tường minh.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="307" x="377" y="174" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="sum_s0" target="sum_s1" style="html=1;endArrow=block;strokeWidth=1.5;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sum_s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. Đưa vào ChatOptions.Tools&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Mỗi request gửi kèm danh sách tool cho mô hình.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="307" x="735" y="174" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="sum_s1" target="sum_s2" style="html=1;endArrow=block;strokeWidth=1.5;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sum_s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. Mô hình chọn tool&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Đọc mô tả + schema, trả FunctionCallContent nếu cần số liệu.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="307" x="1092" y="174" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="sum_s2" target="sum_s3" style="html=1;endArrow=block;strokeWidth=1.5;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sum_bad" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Quên truyền name:?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Hàm local trong top-level statements bị đổi tên kiểu _Main_g_GetStock_0_1; mô hình vẫn gọi được nhưng dễ chọn sai khi có nhiều tool.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="665" x="377" y="306" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="sum_s1" target="sum_bad" style="html=1;endArrow=block;dashed=1;strokeWidth=1.5;" value="lỗi"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sum_why" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="Vì sao phải làm vậy?" vertex="1"><mxGeometry height="30" width="1380" x="20" y="421" as="geometry" /></mxCell>
        <mxCell id="sum_w0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Không tự viết schema&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Schema sinh từ chữ ký hàm nên không lệch với code thật.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="440" x="20" y="455" as="geometry" /></mxCell>
        <mxCell id="sum_w1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Mô tả là prompt&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Mô tả mơ hồ thì mô hình đoán; hàm ghi dữ liệu phải ghi rõ &amp;quot;thao tác GHI&amp;quot;.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="440" x="490" y="455" as="geometry" /></mxCell>
        <mxCell id="sum_w2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Kết quả tự do kiểu&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;record, kiểu ẩn danh, mảng đều được; nhưng mọi byte trả về đều tính token.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="440" x="960" y="455" as="geometry" /></mxCell>
        <mxCell id="sum_names" parent="1" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" value="Tên trong code:  hàm = GetStock   |   tool = get_stock   |   danh sách = ChatOptions.Tools" vertex="1"><mxGeometry height="24" width="1380" x="20" y="560" as="geometry" /></mxCell>
        <mxCell id="problem" parent="1" style="text;html=1;fontSize=18;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;Vấn đề.&lt;/b&gt; Mô hình không chạy được code của bạn, nó chỉ biết tool nào có nhờ danh sách tên + mô tả + JSON schema gửi kèm mỗi request. Viết tay schema dễ sai, nên AIFunctionFactory đọc chữ ký hàm và [Description] để sinh ra." vertex="1"><mxGeometry height="70" width="1380" x="20" y="630" as="geometry" /></mxCell>
        <mxCell id="heading" parent="1" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="F1a — Từ hàm C# đến danh sách tool gửi cho mô hình" vertex="1"><mxGeometry height="30" width="1380" x="20" y="720" as="geometry" /></mxCell>
        <mxCell id="n_fn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:14px&quot;&gt;GetStock — hàm C# + [Description]&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Làm gì: Nhận productCode, trả StockInfo (record) cho SP-001, SP-002 hoặc &amp;quot;không tìm thấy&amp;quot;. Vì sao: Đây là thứ duy nhất thật sự chạy; mô hình chỉ xin gọi nó.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="430" x="140" y="762" as="geometry" /></mxCell>
        <mxCell id="c_fn" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:54-64&#xa;[Description(&amp;quot;Tra số lượng tồn kho hiện tại của một mã sản phẩm trong ERP.&amp;quot;)]&#xa;static StockInfo GetStock([Description(&amp;quot;Mã sản phẩm, ví dụ SP-001&amp;quot;)] string productCode)&#xa;{&#xa;    Console.WriteLine($&amp;quot;     (C# đang chạy GetStock(\&amp;quot;{productCode}\&amp;quot;))&amp;quot;);&#xa;    return productCode.ToUpperInvariant() switch&#xa;    {&#xa;        &amp;quot;SP-001&amp;quot; =&amp;gt; new(&amp;quot;SP-001&amp;quot;, &amp;quot;Bàn phím cơ K87&amp;quot;, 124, &amp;quot;cái&amp;quot;, &amp;quot;Kho Hà Nội&amp;quot;),&#xa;        &amp;quot;SP-002&amp;quot; =&amp;gt; new(&amp;quot;SP-002&amp;quot;, &amp;quot;Chuột không dây M3&amp;quot;, 8, &amp;quot;cái&amp;quot;, &amp;quot;Kho Hà Nội&amp;quot;),&#xa;        _ =&amp;gt; new(productCode, &amp;quot;(không tìm thấy)&amp;quot;, 0, &amp;quot;&amp;quot;, &amp;quot;&amp;quot;)&#xa;    };&#xa;}&lt;/div&gt;" vertex="1"><mxGeometry height="198" width="860" x="620" y="762" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="n_fn" target="c_fn" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_fac" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:14px&quot;&gt;AIFunctionFactory.Create(GetStock, name: &amp;quot;get_stock&amp;quot;)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Làm gì: Sinh AIFunction từ chữ ký hàm và thuộc tính [Description]. Vì sao: Tên tường minh chặn tên rác do trình biên dịch sinh ra.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="430" x="140" y="1010" as="geometry" /></mxCell>
        <mxCell id="c_fac" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:14-17&#xa;// 1. Biến hàm C# thành tool: mô tả và JSON schema tham số được sinh từ chữ ký hàm + [Description].&#xa;//    Đặt tên tường minh: hàm local trong top-level statements bị trình biên dịch đổi tên (kiểu _Main_g_GetStock_0_1).&#xa;AIFunction getStock = AIFunctionFactory.Create(GetStock, name: &amp;quot;get_stock&amp;quot;);&#xa;Console.WriteLine($&amp;quot;Tool: {getStock.Name}\nMô tả: {getStock.Description}\nSchema: {getStock.JsonSchema}\n&amp;quot;);&lt;/div&gt;" vertex="1"><mxGeometry height="96" width="860" x="620" y="1010" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="n_fac" target="c_fac" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_opt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:14px&quot;&gt;ChatOptions { Tools = [getStock] }&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Làm gì: Gói danh sách tool để gửi kèm mỗi request GetResponseAsync. Vì sao: Mô hình quên danh sách sau mỗi request, nên phải gửi lại.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="430" x="140" y="1162" as="geometry" /></mxCell>
        <mxCell id="c_opt" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:19-19&#xa;var options = new ChatOptions { Tools = [getStock] };&lt;/div&gt;" vertex="1"><mxGeometry height="53" width="860" x="620" y="1162" as="geometry" /></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="n_opt" target="c_opt" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Mô hình LLM (Ollama / OpenAI-compatible)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Làm gì: Đọc tên + mô tả + schema, quyết định gọi hay trả lời chữ. Vì sao: Chọn provider bằng biến môi trường LLM_PROVIDER, cùng trả IChatClient.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="430" x="140" y="1314" as="geometry" /></mxCell>
        <mxCell id="c_llm" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:66-79&#xa;static IChatClient CreateClient()&#xa;{&#xa;    string provider = Env(&amp;quot;LLM_PROVIDER&amp;quot;, &amp;quot;ollama&amp;quot;);&#xa;    string model = Env(&amp;quot;LLM_MODEL&amp;quot;, &amp;quot;llama3.2&amp;quot;);&#xa;    return provider switch&#xa;    {&#xa;        &amp;quot;ollama&amp;quot; =&amp;gt; new OllamaApiClient(new Uri(Env(&amp;quot;OLLAMA_ENDPOINT&amp;quot;, &amp;quot;http://localhost:11434&amp;quot;)), model),&#xa;        &amp;quot;openai&amp;quot; =&amp;gt; new OpenAIClient(&#xa;                        new ApiKeyCredential(Env(&amp;quot;OPENAI_API_KEY&amp;quot;, &amp;quot;ollama&amp;quot;)),&#xa;                        new OpenAIClientOptions { Endpoint = new Uri(Env(&amp;quot;OPENAI_ENDPOINT&amp;quot;, &amp;quot;http://localhost:11434/v1&amp;quot;)) })&#xa;                    .GetChatClient(model).AsIChatClient(),&#xa;        _ =&amp;gt; throw new InvalidOperationException($&amp;quot;LLM_PROVIDER không hợp lệ: {provider}&amp;quot;)&#xa;    };&#xa;}&lt;/div&gt;" vertex="1"><mxGeometry height="241" width="860" x="620" y="1314" as="geometry" /></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="n_llm" target="c_llm" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="n_fn" target="n_fac" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;" value="chữ ký + mô tả"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="n_fac" target="n_opt" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;" value="AIFunction"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" edge="1" parent="1" source="n_opt" target="n_llm" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;" value="mỗi request"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p03" name="F1b Vòng lặp thủ công - Các bước kiểm tra">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="F1b — Ex1: vòng lặp thủ công thiếu những kiểm tra nào" vertex="1"><mxGeometry height="30" width="1300" x="20" y="16" as="geometry" /></mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="Code @ 23cd011 (working tree). Ô vàng = điều kiện cần kiểm (code bên trái) | ô đỏ = hậu quả khi code bài mẫu không kiểm | ô xanh đậm = kết quả thành công." vertex="1"><mxGeometry height="40" width="1300" x="20" y="50" as="geometry" /></mxCell>
        <mxCell id="c_r1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:27-28&#xa;ChatResponse response = await client.GetResponseAsync(history, options);&#xa;history.AddMessages(response);&lt;/div&gt;" vertex="1"><mxGeometry height="67" width="760" x="20" y="110" as="geometry" /></mxCell>
        <mxCell id="n_r1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. Lượt 1: gửi lịch sử + Tools&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;GetResponseAsync rồi history.AddMessages(response) để giữ tin gọi hàm.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="420" x="870" y="110" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="c_r1" target="n_r1" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_c1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:31-32&#xa;var calls = response.Messages.SelectMany(m =&amp;gt; m.Contents).OfType&amp;lt;FunctionCallContent&amp;gt;().ToList();&#xa;Console.WriteLine($&amp;quot;Lượt 1: mô hình xin gọi {calls.Count} hàm, FinishReason = {response.FinishReason}&amp;quot;);&lt;/div&gt;" vertex="1"><mxGeometry height="67" width="760" x="20" y="251" as="geometry" /></mxCell>
        <mxCell id="n_c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. Có FunctionCallContent trong response không?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Nên kiểm tra sự có mặt của FunctionCallContent, không dựa vào FinishReason (OllamaSharp trả stop, OpenAI trả tool_calls; PDF trang 6).&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="420" x="870" y="251" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="c_c1" target="n_c1" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_x1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Code không rẽ nhánh khi không có tool call&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;foreach chạy 0 lần nhưng dòng 44 vẫn gọi lượt 2 (đọc từ code, chưa chạy thử).&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="420" x="1390" y="251" as="geometry" /></mxCell>
        <mxCell id="c_c2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:34-39&#xa;foreach (FunctionCallContent call in calls)&#xa;{&#xa;    Console.WriteLine($&amp;quot;  -&amp;gt; {call.Name}({string.Join(&amp;quot;, &amp;quot;, call.Arguments!.Select(a =&amp;gt; $&amp;quot;{a.Key}={a.Value}&amp;quot;))})  [CallId={call.CallId}]&amp;quot;);&#xa;&#xa;    // 4. CODE CỦA BẠN chạy hàm, rồi gửi kết quả lại với đúng CallId&#xa;    object? result = await getStock.InvokeAsync(new AIFunctionArguments(call.Arguments));&lt;/div&gt;" vertex="1"><mxGeometry height="125" width="760" x="20" y="409" as="geometry" /></mxCell>
        <mxCell id="n_c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. Tên hàm mô hình xin có khớp tool nào không?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Ex1 chỉ có một tool nên không tra tên.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="870" y="409" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="c_c2" target="n_c2" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_x2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Hard-code getStock.InvokeAsync&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Nếu thêm tool thứ hai, mọi call vẫn chạy getStock. Ex2 giao việc tra tên cho middleware.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="420" x="1390" y="409" as="geometry" /></mxCell>
        <mxCell id="c_c3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:40-40&#xa;history.Add(new ChatMessage(ChatRole.Tool, [new FunctionResultContent(call.CallId, result)]));&lt;/div&gt;" vertex="1"><mxGeometry height="53" width="760" x="20" y="590" as="geometry" /></mxCell>
        <mxCell id="n_c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. Kết quả gắn đúng CallId chưa?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;CallId nối đơn xin với kết quả; khi mô hình xin 2 hàm cùng lúc, mỗi kết quả phải mang CallId của đơn tương ứng.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="420" x="870" y="590" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="c_c3" target="n_c3" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_x3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Sai CallId: mô hình không ghép được kết quả&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;(suy từ PDF trang 2, chưa chạy thử trường hợp sai CallId)&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="1390" y="590" as="geometry" /></mxCell>
        <mxCell id="c_ok" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex1/Program.cs:44-51&#xa;response = await client.GetResponseAsync(history, options);&#xa;history.AddMessages(response);&#xa;Console.WriteLine($&amp;quot;\nTrợ lý: {response.Text}\n&amp;quot;);&#xa;&#xa;// 6. In toàn bộ lịch sử để thấy 4 loại tin nhắn&#xa;Console.WriteLine(&amp;quot;Lịch sử hội thoại:&amp;quot;);&#xa;foreach (ChatMessage m in history)&#xa;    Console.WriteLine($&amp;quot;  [{m.Role}] {string.Join(&amp;quot;, &amp;quot;, m.Contents.Select(c =&amp;gt; c.GetType().Name))}&amp;quot;);&lt;/div&gt;" vertex="1"><mxGeometry height="154" width="760" x="20" y="731" as="geometry" /></mxCell>
        <mxCell id="n_ok" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#b9e0a5;strokeColor=#4d8f2c;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;5. Lượt 2: mô hình viết câu trả lời cuối&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Lịch sử đủ 5 tin: system, user, assistant(Call), tool(Result), assistant(Text).&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="420" x="870" y="731" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="c_ok" target="n_ok" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="n_r1" target="n_c1" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="n_c1" target="n_c2" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;" value="Có"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="n_c1" target="n_x1" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;" value="Không"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="n_c2" target="n_c3" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;" value="Khớp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="n_c2" target="n_x2" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;" value="Không tra"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" edge="1" parent="1" source="n_c3" target="n_ok" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;" value="Đúng"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" edge="1" parent="1" source="n_c3" target="n_x3" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;" value="Sai"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p04" name="F2a UseFunctionInvocation - Kiến trúc">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="sum_t" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="Flow 2 trong 1 phút: thuê quản lý đi kho thay bạn, và gắn máy quét thẻ ở cổng" vertex="1"><mxGeometry height="30" width="1380" x="20" y="20" as="geometry" /></mxCell>
        <mxCell id="sum_ctx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Vấn đề của Ex1&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Tự viết foreach thì mỗi chatbot lặp lại cùng đoạn code, và dễ quên giới hạn số vòng.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="1380" x="20" y="62" as="geometry" /></mxCell>
        <mxCell id="sum_leg" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="Màu ô:  xanh lá = code bài mẫu   |   xanh dương = middleware thư viện   |   vàng = kiểm soát / log   |   tím = mô hình" vertex="1"><mxGeometry height="22" width="1380" x="20" y="144" as="geometry" /></mxCell>
        <mxCell id="sum_s0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. Bọc client&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Bọc client gốc bằng ChatClientBuilder rồi gọi UseFunctionInvocation().&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="307" x="20" y="174" as="geometry" /></mxCell>
        <mxCell id="sum_s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. Gọi một lần&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;GetResponseAsync hoặc GetStreamingResponseAsync; bên trong có thể nhiều vòng hỏi mô hình, chạy hàm, hỏi lại.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="307" x="377" y="174" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="sum_s0" target="sum_s1" style="html=1;endArrow=block;strokeWidth=1.5;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sum_s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. FunctionInvoker bọc mỗi lần chạy hàm&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Chỗ để log, đo thời gian, kiểm tra quyền (Ex3).&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="307" x="735" y="174" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="sum_s1" target="sum_s2" style="html=1;endArrow=block;strokeWidth=1.5;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sum_s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. Trả về mọi tin trung gian&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;response.Messages có gọi hàm, kết quả, câu cuối; response.Usage là tổng token mọi vòng.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="307" x="1092" y="174" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="sum_s2" target="sum_s3" style="html=1;endArrow=block;strokeWidth=1.5;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sum_bad" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Hàm ném exception?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;FunctionInvoker log lỗi đầy đủ rồi throw; middleware báo mô hình chung chung &amp;quot;Error: Function failed.&amp;quot; (IncludeDetailedErrors = false).&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="665" x="735" y="306" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="sum_s2" target="sum_bad" style="html=1;endArrow=block;dashed=1;strokeWidth=1.5;" value="lỗi"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sum_why" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="Vì sao phải làm vậy?" vertex="1"><mxGeometry height="30" width="1380" x="20" y="421" as="geometry" /></mxCell>
        <mxCell id="sum_w0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Một chỗ cấu hình&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;MaximumIterationsPerRequest, MaximumConsecutiveErrorsPerRequest, IncludeDetailedErrors, AllowConcurrentInvocation.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="440" x="20" y="455" as="geometry" /></mxCell>
        <mxCell id="sum_w1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Một chỗ kiểm soát&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;FunctionInvoker thấy mọi lần gọi hàm: nơi tự nhiên để kiểm tra người dùng có quyền xem kho này không.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="440" x="490" y="455" as="geometry" /></mxCell>
        <mxCell id="sum_w2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Streaming vẫn đủ ngữ cảnh&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;updates.ToChatResponse() giữ cả FunctionCallContent và FunctionResultContent cho lịch sử.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="440" x="960" y="455" as="geometry" /></mxCell>
        <mxCell id="sum_names" parent="1" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" value="Tên trong code:  middleware = FunctionInvokingChatClient   |   hook = FunctionInvoker   |   tool = Erp.GetStock / GetOrderStatus / ListLowStock" vertex="1"><mxGeometry height="24" width="1380" x="20" y="560" as="geometry" /></mxCell>
        <mxCell id="problem" parent="1" style="text;html=1;fontSize=18;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b&gt;Vấn đề.&lt;/b&gt; Vòng lặp ở Ex1 phải viết lại cho mọi chatbot: tra tool theo tên, xử lý nhiều call cùng lúc, lặp nếu mô hình xin tiếp. UseFunctionInvocation() bọc client trong FunctionInvokingChatClient để làm hết việc đó, code gọi vẫn chỉ một GetResponseAsync." vertex="1"><mxGeometry height="70" width="1380" x="20" y="630" as="geometry" /></mxCell>
        <mxCell id="heading" parent="1" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="F2a — ChatClientBuilder, FunctionInvokingChatClient, FunctionInvoker và tool" vertex="1"><mxGeometry height="30" width="1380" x="20" y="720" as="geometry" /></mxCell>
        <mxCell id="n_loop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Vòng chat — streaming + giữ lịch sử&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Làm gì: Thêm tin User, in từng update.Text, gom updates, rồi history.AddMessages(updates.ToChatResponse()). Vì sao: Lượt sau mô hình còn nhớ số đã tra vì lịch sử có cả tin gọi hàm và kết quả.&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="430" x="140" y="762" as="geometry" /></mxCell>
        <mxCell id="c_loop" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex3/Program.cs:70-82&#xa;history.Add(new ChatMessage(ChatRole.User, input));&#xa;Console.Write(&amp;quot;Trợ lý: &amp;quot;);&#xa;List&amp;lt;ChatResponseUpdate&amp;gt; updates = [];&#xa;await foreach (var update in client.GetStreamingResponseAsync(history, options))&#xa;{&#xa;    Console.Write(update.Text);&#xa;    updates.Add(update);&#xa;}&#xa;Console.WriteLine();&#xa;&#xa;// Các update gồm cả FunctionCallContent/FunctionResultContent -&amp;gt; lịch sử giữ đủ ngữ cảnh gọi hàm&#xa;history.AddMessages(updates.ToChatResponse());&#xa;Console.WriteLine($&amp;quot;  [lịch sử: {history.Count} tin]&amp;quot;);&lt;/div&gt;" vertex="1"><mxGeometry height="227" width="860" x="620" y="762" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="n_loop" target="c_loop" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:14px&quot;&gt;ChatClientBuilder.UseFunctionInvocation(configure)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Làm gì: Bọc client gốc, đặt giới hạn: tối đa 5 vòng, 2 lỗi liên tiếp, không đưa chi tiết lỗi cho mô hình, chạy hàm tuần tự. Vì sao: Mặc định là 40 vòng; chatbot ERP đặt 5 để một câu hỏi không đốt hàng chục lần gọi mô hình.&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="430" x="140" y="1039" as="geometry" /></mxCell>
        <mxCell id="c_b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex3/Program.cs:13-20&#xa;IChatClient client = new ChatClientBuilder(CreateClient())&#xa;    .UseFunctionInvocation(configure: f =&amp;gt;&#xa;    {&#xa;        f.MaximumIterationsPerRequest = 5;          // mặc định 40: chặn vòng lặp gọi hàm vô hạn&#xa;        f.MaximumConsecutiveErrorsPerRequest = 2;   // mặc định 3&#xa;        f.IncludeDetailedErrors = false;            // mặc định false: không đưa nội dung exception cho mô hình&#xa;        f.AllowConcurrentInvocation = false;        // mặc định false: các hàm chạy lần lượt&#xa;&lt;/div&gt;" vertex="1"><mxGeometry height="154" width="860" x="620" y="1039" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="n_b" target="c_b" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_inv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:14px&quot;&gt;FunctionInvoker — bọc mọi lần gọi hàm&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Làm gì: Bấm giờ, in tên tool + tham số, chạy ctx.Function.InvokeAsync, log &amp;quot;ok&amp;quot; hoặc &amp;quot;LỖI&amp;quot; rồi throw lại. Vì sao: Đây là chỗ cắm log và kiểm quyền; throw lại để middleware tính vào số lỗi liên tiếp.&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="430" x="140" y="1243" as="geometry" /></mxCell>
        <mxCell id="c_inv" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex3/Program.cs:22-37&#xa;f.FunctionInvoker = async (ctx, ct) =&amp;gt;&#xa;{&#xa;    var sw = Stopwatch.StartNew();&#xa;    Console.Write($&amp;quot;\n   [tool] {ctx.Function.Name}({string.Join(&amp;quot;, &amp;quot;, ctx.Arguments.Select(a =&amp;gt; $&amp;quot;{a.Key}={a.Value}&amp;quot;))})&amp;quot;);&#xa;    try&#xa;    {&#xa;        object? result = await ctx.Function.InvokeAsync(ctx.Arguments, ct);&#xa;        Console.WriteLine($&amp;quot; -&amp;gt; ok, {sw.ElapsedMilliseconds} ms (vòng {ctx.Iteration})&amp;quot;);&#xa;        return result;&#xa;    }&#xa;    catch (Exception ex)&#xa;    {&#xa;        Console.WriteLine($&amp;quot; -&amp;gt; LỖI: {ex.Message}&amp;quot;);&#xa;        throw; // để FunctionInvokingChatClient báo lỗi cho mô hình (dạng chung chung vì IncludeDetailedErrors=false)&#xa;    }&#xa;};&lt;/div&gt;" vertex="1"><mxGeometry height="270" width="860" x="620" y="1243" as="geometry" /></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="n_inv" target="c_inv" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_tool" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Erp.GetStock — tool ném exception khi không có mã&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Làm gì: Tra Dictionary; thiếu mã thì ném KeyNotFoundException kèm câu SQL mẫu. Vì sao: Cố ý để thấy: console người phát triển thấy đủ SQL, mô hình chỉ nhận lỗi chung chung.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="430" x="140" y="1564" as="geometry" /></mxCell>
        <mxCell id="c_tool" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex3/Program.cs:120-127&#xa;[Description(&amp;quot;Tra số lượng tồn kho hiện tại của một mã sản phẩm.&amp;quot;)]&#xa;public static object GetStock([Description(&amp;quot;Mã sản phẩm, dạng SP-xxx&amp;quot;)] string productCode)&#xa;{&#xa;    string code = productCode.Trim().ToUpperInvariant();&#xa;    if (!Stock.TryGetValue(code, out var s))&#xa;        throw new KeyNotFoundException($&amp;quot;Không có sản phẩm {code} trong bảng Items (SQL: SELECT ... WHERE Code=&amp;#x27;{code}&amp;#x27;)&amp;quot;);&#xa;    return new { productCode = code, productName = s.Name, quantity = s.Qty, unit = s.Unit };&#xa;}&lt;/div&gt;" vertex="1"><mxGeometry height="154" width="860" x="620" y="1564" as="geometry" /></mxCell>
        <mxCell id="e8" edge="1" parent="1" source="n_tool" target="c_tool" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" edge="1" parent="1" source="n_loop" target="n_b" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;" value="GetStreamingResponseAsync"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="n_b" target="n_inv" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;" value="mỗi tool call"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" edge="1" parent="1" source="n_inv" target="n_tool" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;" value="InvokeAsync"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sec0_t" parent="1" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="Ex2 so với Ex3" vertex="1"><mxGeometry height="30" width="1380" x="20" y="1768" as="geometry" /></mxCell>
        <mxCell id="sec0_n" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="Ex2 gọi một lần và soi response.Messages; Ex3 dùng streaming và giữ lịch sử nhiều lượt." vertex="1"><mxGeometry height="34" width="1380" x="20" y="1802" as="geometry" /></mxCell>
        <mxCell id="sec0_b0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Ex2&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Mỗi câu hỏi tạo history mới (Ex2/Program.cs:30-34): các câu không nhớ nhau. In response.Messages và Usage (:43-54).&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="675" x="20" y="1842" as="geometry" /></mxCell>
        <mxCell id="sec0_b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Ex3&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;history dùng chung cả phiên (Ex3/Program.cs:52-60, :81); 3 tool; temperature 0.1 (:43).&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="675" x="725" y="1842" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p05" name="F2b Khi tool lỗi - Các bước kiểm tra">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="F2b — Ex3: điều gì xảy ra khi tool lỗi hoặc mô hình gọi quá nhiều" vertex="1"><mxGeometry height="30" width="1300" x="20" y="16" as="geometry" /></mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="Code @ 23cd011 (working tree). Ô vàng = điều kiện (code bên trái) | ô đỏ = kết quả bị chặn / báo lỗi | ô xanh đậm = thành công. Thứ tự và thông báo &quot;Error: Function failed.&quot; lấy từ PDF, chưa chạy thật." vertex="1"><mxGeometry height="40" width="1300" x="20" y="50" as="geometry" /></mxCell>
        <mxCell id="c_s" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex3/Program.cs:22-25&#xa;f.FunctionInvoker = async (ctx, ct) =&amp;gt;&#xa;{&#xa;    var sw = Stopwatch.StartNew();&#xa;    Console.Write($&amp;quot;\n   [tool] {ctx.Function.Name}({string.Join(&amp;quot;, &amp;quot;, ctx.Arguments.Select(a =&amp;gt; $&amp;quot;{a.Key}={a.Value}&amp;quot;))})&amp;quot;);&lt;/div&gt;" vertex="1"><mxGeometry height="96" width="760" x="20" y="110" as="geometry" /></mxCell>
        <mxCell id="n_s" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. Mô hình xin gọi một tool&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;FunctionInvokingChatClient nhận FunctionCallContent và gọi FunctionInvoker.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="420" x="1100" y="110" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="c_s" target="n_s" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_c1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex3/Program.cs:16-16&#xa;f.MaximumIterationsPerRequest = 5;          // mặc định 40: chặn vòng lặp gọi hàm vô hạn&lt;/div&gt;" vertex="1"><mxGeometry height="53" width="760" x="20" y="262" as="geometry" /></mxCell>
        <mxCell id="n_c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. Đã quá MaximumIterationsPerRequest (5)?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Chặn vòng gọi hàm vô hạn; mặc định thư viện là 40.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="1100" y="262" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="c_c1" target="n_c1" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_x1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Dừng vòng lặp&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Không còn gọi mô hình thêm cho câu hỏi này.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="1850" y="262" as="geometry" /></mxCell>
        <mxCell id="c_c2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex3/Program.cs:26-31&#xa;try&#xa;{&#xa;    object? result = await ctx.Function.InvokeAsync(ctx.Arguments, ct);&#xa;    Console.WriteLine($&amp;quot; -&amp;gt; ok, {sw.ElapsedMilliseconds} ms (vòng {ctx.Iteration})&amp;quot;);&#xa;    return result;&#xa;}&lt;/div&gt;" vertex="1"><mxGeometry height="125" width="760" x="20" y="386" as="geometry" /></mxCell>
        <mxCell id="n_c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. Hàm chạy xong không ném exception?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;FunctionInvoker bấm giờ và gọi ctx.Function.InvokeAsync.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="1100" y="386" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="c_c2" target="n_c2" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_x2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex3/Program.cs:32-36&#xa;catch (Exception ex)&#xa;{&#xa;    Console.WriteLine($&amp;quot; -&amp;gt; LỖI: {ex.Message}&amp;quot;);&#xa;    throw; // để FunctionInvokingChatClient báo lỗi cho mô hình (dạng chung chung vì IncludeDetailedErrors=false)&#xa;}&#xa;&#xa;// tutorial/ngay-02/Ex3/Program.cs:124-125&#xa;if (!Stock.TryGetValue(code, out var s))&#xa;    throw new KeyNotFoundException($&amp;quot;Không có sản phẩm {code} trong bảng Items (SQL: SELECT ... WHERE Code=&amp;#x27;{code}&amp;#x27;)&amp;quot;);&lt;/div&gt;" vertex="1"><mxGeometry height="169" width="760" x="20" y="568" as="geometry" /></mxCell>
        <mxCell id="n_x2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Log LỖI rồi throw&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Console người phát triển thấy: &amp;quot;Không có sản phẩm SP-999 trong bảng Items (SQL: ...)&amp;quot;.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="420" x="870" y="568" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="c_x2" target="n_x2" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_ok" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex3/Program.cs:28-30&#xa;object? result = await ctx.Function.InvokeAsync(ctx.Arguments, ct);&#xa;Console.WriteLine($&amp;quot; -&amp;gt; ok, {sw.ElapsedMilliseconds} ms (vòng {ctx.Iteration})&amp;quot;);&#xa;return result;&lt;/div&gt;" vertex="1"><mxGeometry height="82" width="760" x="20" y="751" as="geometry" /></mxCell>
        <mxCell id="n_ok" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#b9e0a5;strokeColor=#4d8f2c;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;6. Kết quả hàm quay lại mô hình, viết câu trả lời&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Log: &amp;quot; -&amp;gt; ok, N ms (vòng K)&amp;quot;.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="1330" y="568" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="c_ok" target="n_ok" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_c3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex3/Program.cs:18-18&#xa;f.IncludeDetailedErrors = false;            // mặc định false: không đưa nội dung exception cho mô hình&lt;/div&gt;" vertex="1"><mxGeometry height="53" width="760" x="20" y="889" as="geometry" /></mxCell>
        <mxCell id="n_c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. Chi tiết lỗi có đưa cho mô hình không (IncludeDetailedErrors)?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Đặt false: mô hình không thấy nội dung exception, tránh lộ SQL.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="420" x="1100" y="889" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="c_c3" target="n_c3" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_x3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Mô hình nhận: &amp;quot;Error: Function failed.&amp;quot;&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Nguồn: PDF trang 7. Mô hình nhỏ có thể diễn đạt lại vụng.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="1100" y="1047" as="geometry" /></mxCell>
        <mxCell id="c_c4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// tutorial/ngay-02/Ex3/Program.cs:17-17&#xa;f.MaximumConsecutiveErrorsPerRequest = 2;   // mặc định 3&lt;/div&gt;" vertex="1"><mxGeometry height="53" width="760" x="20" y="1171" as="geometry" /></mxCell>
        <mxCell id="n_c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;5. Lỗi liên tiếp đạt MaximumConsecutiveErrorsPerRequest (2)?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Mặc định 3; Ex3 hạ xuống 2.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="420" x="1100" y="1171" as="geometry" /></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="c_c4" target="n_c4" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n_x4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Ném exception ra ngoài vòng chat&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Ex3 không có try/catch quanh vòng foreach ở dòng 73: phiên chat sẽ sập (đọc từ code, chưa chạy thử).&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="420" x="1850" y="1171" as="geometry" /></mxCell>
