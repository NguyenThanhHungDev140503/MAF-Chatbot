        <mxCell id="lh_svc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;ErpAgentService&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Agent&lt;/span&gt;" vertex="1"><mxGeometry height="54" width="290" x="328" y="114" as="geometry" /></mxCell>
        <mxCell id="lane_core" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;opacity=35;" value="" vertex="1"><mxGeometry height="1198" width="290" x="636" y="114" as="geometry" /></mxCell>
        <mxCell id="lh_core" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:13px&quot;&gt;SessionStats&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Core&lt;/span&gt;" vertex="1"><mxGeometry height="54" width="290" x="636" y="114" as="geometry" /></mxCell>
        <mxCell id="s_a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. Nhận &amp;#x27;/reset&amp;#x27;&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Gọi ResetSessionAsync rồi in thông báo xoá lịch sử.&#xa;Code: code/src/ErpChatbot.Cli/CliRunner.cs:51-56&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="260" x="35" y="174" as="geometry" /></mxCell>
        <mxCell id="s_a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. Tạo session mới&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;_session = CreateSessionAsync(); không đụng _stats.&#xa;Code: code/src/ErpChatbot.Agent/Services/ErpAgentService.cs:90-95&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="260" x="343" y="339" as="geometry" /></mxCell>
        <mxCell id="s_b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. Nhận &amp;#x27;/stats&amp;#x27;&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Lấy SessionStats từ service rồi in lượt và token.&#xa;Code: code/src/ErpChatbot.Cli/CliRunner.cs:58-67&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="260" x="35" y="504" as="geometry" /></mxCell>
        <mxCell id="s_b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. GetStats()&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Trả đúng đối tượng _stats đang giữ.&#xa;Code: code/src/ErpChatbot.Agent/Services/ErpAgentService.cs:97-97&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="260" x="343" y="669" as="geometry" /></mxCell>
        <mxCell id="s_b3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:13px&quot;&gt;5. Đọc TotalTokens&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;TotalTokens = TotalInputTokens + TotalOutputTokens.&#xa;Code: code/src/ErpChatbot.Core/Models/SessionStats.cs:3-8&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="260" x="651" y="817" as="geometry" /></mxCell>
        <mxCell id="s_c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b style=&quot;font-size:13px&quot;&gt;6. Lượt đầu: tạo session&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;_session ??= CreateSessionAsync(); các lượt sau dùng lại.&#xa;Code: code/src/ErpChatbot.Agent/Services/ErpAgentService.cs:36-37&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="260" x="343" y="982" as="geometry" /></mxCell>
        <mxCell id="s_c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b style=&quot;font-size:13px&quot;&gt;7. RecordTurn&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;TurnCount tăng 1; cộng token vào và ra, kể cả khi token bằng 0.&#xa;Code: code/src/ErpChatbot.Core/Models/SessionStats.cs:10-15&lt;/span&gt;" vertex="1"><mxGeometry height="119" width="260" x="651" y="1147" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="s_a1" target="s_a2" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;" value="ResetSessionAsync"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="s_b1" target="s_b2" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;" value="GetStats"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="s_b2" target="s_b3" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
