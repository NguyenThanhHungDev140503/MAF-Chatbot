  <diagram id="p09" name="F5 Hủy lượt và xử lý lỗi - Các bước kiểm tra">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="F5 — Ctrl+C và ba tầng catch" vertex="1"><mxGeometry height="30" width="1300" x="20" y="16" as="geometry" /></mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" value="Code @ 23cd011" vertex="1"><mxGeometry height="40" width="1300" x="20" y="50" as="geometry" /></mxCell>
        <mxCell id="c_cc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/Program.cs:81-96&#xa;using var turnCts = new CancellationTokenSource();&#xa;ConsoleCancelEventHandler cancelHandler = (_, e) =&amp;gt;&#xa;{&#xa;    e.Cancel = true; // Không tắt app, chỉ cancel lượt stream hiện tại&#xa;    turnCts.Cancel();&#xa;};&#xa;Console.CancelKeyPress += cancelHandler;&#xa;&#xa;try&#xa;{&#xa;    if (!await chatLoop.ProcessLineAsync(rawInput, turnCts.Token)) break;&#xa;}&#xa;finally&#xa;{&#xa;    Console.CancelKeyPress -= cancelHandler;&#xa;}&lt;/div&gt;" vertex="1"><mxGeometry height="270" width="724" x="20" y="110" as="geometry" /></mxCell>
        <mxCell id="n_cc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;1. Ctrl+C trong lúc xử lý lượt&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Handler đặt e.Cancel = true (không tắt app) rồi turnCts.Cancel(). Handler chỉ gắn sau ReadLine và gỡ khi lượt xong, nên Ctrl+C ở dấu nhắc &amp;#x27;Bạn:&amp;#x27; vẫn thoát process (chưa chạy thật).&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="420" x="834" y="110" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="c_cc" target="n_cc" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_d1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:147-147&#xa;catch (OperationCanceledException) when (userCancellation.IsCancellationRequested)&lt;/div&gt;" vertex="1"><mxGeometry height="53" width="724" x="20" y="436" as="geometry" /></mxCell>
        <mxCell id="n_d1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;2. OperationCanceledException và token người dùng đã hủy?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Điều kiện when (userCancellation.IsCancellationRequested).&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="420" x="834" y="436" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="c_d1" target="n_d1" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_r1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:147-150&#xa;catch (OperationCanceledException) when (userCancellation.IsCancellationRequested)&#xa;{&#xa;    WriteLine(ConsoleColor.Yellow, &amp;quot;\n(đã hủy phản hồi)&amp;quot;);&#xa;}&lt;/div&gt;" vertex="1"><mxGeometry height="96" width="724" x="20" y="503" as="geometry" /></mxCell>
        <mxCell id="n_r1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Hủy: &amp;#x27;(đã hủy phản hồi)&amp;#x27; (vàng)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Không phải lỗi; session giữ nguyên. Sau đó return true: vòng lặp tiếp tục, _session giữ nguyên.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="420" x="1354" y="436" as="geometry" /></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="c_r1" target="n_r1" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_d2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:151-153&#xa;catch (Exception ex) when (ex is HttpRequestException or TimeoutException or OperationCanceledException)&#xa;{&#xa;    // OperationCanceledException tới đây là timeout của HttpClient, không phải user hủy&lt;/div&gt;" vertex="1"><mxGeometry height="82" width="724" x="20" y="656" as="geometry" /></mxCell>
        <mxCell id="n_d2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;3. HttpRequestException, TimeoutException hoặc OperationCanceledException?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;OperationCanceledException tới đây là timeout của HttpClient, không phải người dùng hủy.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="420" x="834" y="656" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="c_d2" target="n_d2" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_r2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:154-154&#xa;WriteLine(ConsoleColor.Red, $&amp;quot;\n[Mất kết nối tới Ollama: {ex.Message}. Thử lại hoặc gõ /reset]&amp;quot;);&lt;/div&gt;" vertex="1"><mxGeometry height="53" width="724" x="20" y="752" as="geometry" /></mxCell>
        <mxCell id="n_r2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Báo: mất kết nối tới Ollama (đỏ)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&amp;quot;[Mất kết nối tới Ollama: &amp;lt;message&amp;gt;. Thử lại hoặc gõ /reset]&amp;quot; Sau đó return true: vòng lặp tiếp tục, _session giữ nguyên.&lt;/span&gt;" vertex="1"><mxGeometry height="102" width="420" x="1354" y="656" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="c_r2" target="n_r2" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_o" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:156-156&#xa;catch (Exception ex)&lt;/div&gt;" vertex="1"><mxGeometry height="53" width="724" x="20" y="861" as="geometry" /></mxCell>
        <mxCell id="n_o" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;4. Mọi exception còn lại&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Catch cuối cùng (Exception ex), không có điều kiện when.&lt;/span&gt;" vertex="1"><mxGeometry height="68" width="420" x="834" y="861" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="c_o" target="n_o" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_r3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:157-159&#xa;{&#xa;    WriteLine(ConsoleColor.Red, $&amp;quot;\n[Lỗi xử lý: {ex.Message}]&amp;quot;);&#xa;}&#xa;&#xa;// code/src/ErpChatbot.Cli/CliRunner.cs:161-161&#xa;return true;&lt;/div&gt;" vertex="1"><mxGeometry height="125" width="724" x="20" y="928" as="geometry" /></mxCell>
        <mxCell id="n_r3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Báo: lỗi xử lý (đỏ)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&amp;quot;[Lỗi xử lý: &amp;lt;message&amp;gt;]&amp;quot; cho mọi exception còn lại. Sau đó return true: vòng lặp tiếp tục, _session giữ nguyên.&lt;/span&gt;" vertex="1"><mxGeometry height="85" width="420" x="1354" y="861" as="geometry" /></mxCell>
