        <mxCell id="e15" edge="1" parent="1" source="n_d2" target="n_r2" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;" value="Có"><mxGeometry relative="1" as="geometry" /></mxCell>
