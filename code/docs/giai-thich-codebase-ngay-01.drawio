        <mxCell id="e11" edge="1" parent="1" source="n_ping" target="n_ok" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;" value="Trả về bình thường"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" edge="1" parent="1" source="n_ping" target="n_d1" style="html=1;endArrow=block;strokeWidth=1.5;fontSize=12;edgeStyle=orthogonalEdgeStyle;rounded=0;" value="Có exception"><mxGeometry relative="1" as="geometry" /></mxCell>
