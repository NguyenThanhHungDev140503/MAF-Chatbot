        <mxCell id="code_t" parent="1" style="text;html=1;fontSize=16;fontStyle=1;align=left;" value="Code theo từng bước" vertex="1"><mxGeometry height="28" width="600" x="20" y="1012" as="geometry" /></mxCell>
        <mxCell id="cs1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;1. Gõ một dòng, Enter&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/Program.cs:78-78&#xa;string? rawInput = Console.ReadLine();&lt;/div&gt;" vertex="1"><mxGeometry height="79" width="520" x="20" y="1052" as="geometry" /></mxCell>
        <mxCell id="cs2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;2. ProcessLineAsync(rawInput, turnCts.Token)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/Program.cs:91-91&#xa;if (!await chatLoop.ProcessLineAsync(rawInput, turnCts.Token)) break;&lt;/div&gt;" vertex="1"><mxGeometry height="79" width="520" x="20" y="1155" as="geometry" /></mxCell>
        <mxCell id="cs3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;3. HandleInputAsync(rawInput)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:116-116&#xa;var inputResult = await _commandHandler.HandleInputAsync(rawInput, userCancellation);&lt;/div&gt;" vertex="1"><mxGeometry height="79" width="597" x="20" y="1258" as="geometry" /></mxCell>
        <mxCell id="cs4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;4. SendToLlm (dòng không bắt đầu bằng &amp;#x27;/&amp;#x27;)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:88-88&#xa;return CliInputResult.SendToLlm;&lt;/div&gt;" vertex="1"><mxGeometry height="79" width="520" x="20" y="1361" as="geometry" /></mxCell>
        <mxCell id="cs5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;5. RunStreamingAsync(rawInput, token)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:134-134&#xa;await foreach (var chunk in _agentService.RunStreamingAsync(rawInput, userCancellation))&lt;/div&gt;" vertex="1"><mxGeometry height="79" width="617" x="20" y="1464" as="geometry" /></mxCell>
        <mxCell id="cs6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;6. Lượt đầu tạo AgentSession, rồi RunStreamingAsync(prompt, _session)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Agent/Services/ErpAgentService.cs:37-37&#xa;_session ??= await _agent.CreateSessionAsync(cancellationToken);&#xa;&#xa;// code/src/ErpChatbot.Agent/Services/ErpAgentService.cs:43-43&#xa;var responseStream = _agent.RunStreamingAsync(userPrompt, _session, options: null, cancellationToken: cancellationToken);&lt;/div&gt;" vertex="1"><mxGeometry height="122" width="760" x="20" y="1567" as="geometry" /></mxCell>
        <mxCell id="cs9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;9. yield return update.Text&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Agent/Services/ErpAgentService.cs:67-70&#xa;if (!string.IsNullOrEmpty(update.Text))&#xa;{&#xa;    yield return update.Text;&#xa;}&lt;/div&gt;" vertex="1"><mxGeometry height="122" width="520" x="20" y="1713" as="geometry" /></mxCell>
        <mxCell id="cs10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;10. Console.Write(chunk)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Cli/CliRunner.cs:134-137&#xa;await foreach (var chunk in _agentService.RunStreamingAsync(rawInput, userCancellation))&#xa;{&#xa;    Console.Write(chunk);&#xa;}&lt;/div&gt;" vertex="1"><mxGeometry height="122" width="617" x="20" y="1860" as="geometry" /></mxCell>
        <mxCell id="cs11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#222222;" value="&lt;b&gt;11. Hết stream: RecordTurn(input, output)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;white-space:pre;font-family:Courier New,monospace;font-size:11px;text-align:left&quot;&gt;// code/src/ErpChatbot.Agent/Services/ErpAgentService.cs:87-87&#xa;_stats.RecordTurn(turnInputTokens, turnOutputTokens);&lt;/div&gt;" vertex="1"><mxGeometry height="79" width="520" x="20" y="2006" as="geometry" /></mxCell>
      </root>
